# ==============================================================================
# Clinix - AI Healthcare Assistant Configuration
# ==============================================================================
# IMPORTANT: Never commit sensitive keys (.env.local) to version control.
# Only variables prefixed with NEXT_PUBLIC_ are accessible in client-side code.

# Core Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=changeme_in_production_min_32_characters_random_secret_string

# Database
# Connect to MongoDB Atlas or local MongoDB instance
MONGODB_URI=mongodb://localhost:27017/clinix

# NVIDIA AI Inference (Server-side ONLY - NEVER use NEXT_PUBLIC_ prefix)
# Used for symptom assessment assistance in later phases
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
AI_TIMEOUT_MS=30000
AI_MAX_ATTEMPTS=2

# Maps & Geolocation (Server-side ONLY)
# Choose one provider: google or mapbox
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key
MAPBOX_ACCESS_TOKEN=your_mapbox_server_token
# Optional restricted browser key for client-side map rendering
NEXT_PUBLIC_MAPS_PUBLIC_KEY=

# Email Delivery (Resend - Server-side ONLY)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Clinix Health <no-reply@clinixhealth.org>

# Emergency Configuration Defaults
# ISO 3166-1 alpha-2 country code (default Ghana)
DEFAULT_COUNTRY=GH
DEFAULT_EMERGENCY_NUMBER=112

# Safety & Operations
FEATURE_FLAGS_SOURCE=db
LOG_LEVEL=info
